{
  "name": "calm-breath",
  "version": "0.1.0",
  "description": "Calm Breath: a camera-based adaptive breathing pacer for relaxation. Presage SmartSpectra SDK challenge entry.",
  "license": "MIT",
  "author": "Maryan Kondratyuk",
  "repository": {
    "type": "git",
    "url": "https://github.com/kindrat86/calm-breath"
  },
  "main": "main.js",
  "scripts": {
    "build": "esbuild renderer.js --bundle --outfile=dist/renderer.bundle.js --platform=browser --format=iife --log-level=warning",
    "start": "npm run build && electron .",
    "test": "node --test tests/",
    "harness": "node scripts/live-path-harness.js",
    "smoke": "npm run build && xvfb-run -a electron . --smoke",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux --x64"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.4.0"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.6.0",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "com.kindrat86.calm-breath",
    "productName": "Calm Breath",
    "files": [
      "main.js",
      "preload-extension.js",
      "index.html",
      "styles.css",
      "dist/**",
      "node_modules/**",
      "!node_modules/@smartspectra/node-sdk-*/**",
      "!node_modules/@smartspectra/node-sdk/scripts/**",
      "!node_modules/@smartspectra/node-sdk/test/**",
      "!node_modules/@smartspectra/node-sdk/samples/**",
      "!node_modules/@smartspectra/node-sdk/prebuilds/**"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Calm Breath uses the camera to estimate your breathing rate locally. Video never leaves your device and nothing is stored."
      },
      "extraResources": [
        { "from": "node_modules/@smartspectra/node-sdk-darwin-${arch}/", "to": "smartspectra" }
      ]
    },
    "win": {
      "target": "nsis",
      "extraResources": [
        { "from": "node_modules/@smartspectra/node-sdk-win32-${arch}/", "to": "smartspectra" }
      ]
    },
    "linux": {
      "target": "AppImage",
      "extraResources": [
        { "from": "node_modules/@smartspectra/node-sdk-linux-${arch}/", "to": "smartspectra" }
      ]
    },
    "asar": true
  }
}
