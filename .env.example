# Calm Breath configuration.
# 1. Copy this file to .env  (cp .env.example .env)
# 2. Paste your Presage API key from https://physiology.presagetech.com/
# The key never leaves your machine except to Presage's SDK service for
# authentication. .env is gitignored; never commit a real key.
SMARTSPECTRA_API_KEY=your_presage_api_key_here
